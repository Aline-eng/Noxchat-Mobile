    "@tanstack/react-query": "^5.59.0",
    "expo": "~52.0.0",
    "expo-font": "~13.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "lucide-react-native": "^0.454.0",
    "moti": "^0.29.0",
    "react": "18.3.1",
